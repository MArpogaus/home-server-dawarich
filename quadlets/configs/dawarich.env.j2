# The app and Sidekiq. The keys after the config are the role's, and the last
# value of a key wins.
{% for key, value in (dawarich_service_config_defaults | combine(dawarich_service_config, recursive=true)).items() %}
{{ key }}={{ value | lower if value is boolean else value }}
{% endfor %}
RAILS_ENV=production
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=dawarich
DATABASE_NAME=dawarich
REDIS_URL=redis://127.0.0.1:6379
APPLICATION_HOSTS={{ [dawarich_service_hostname, '127.0.0.1', 'localhost'] | select | join(',') }}
# TLS ends at the proxy.
APPLICATION_PROTOCOL=http
